{
  "name": "lms-rag",
  "version": "0.2.0",
  "private": true,
  "description": "RAG chatbot service for the Temple LMS — chunking, embeddings, retrieval, LLM answer generation, background ingest queue, multi-tenant. Runs as a standalone service alongside lms-app / lms-admin-app / lms-service.",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @ai-guru/api dev",
    "dev:api": "pnpm --filter @ai-guru/api dev",
    "ingest": "pnpm --filter @ai-guru/core ingest",
    "eval": "pnpm --filter @ai-guru/core eval",
    "migrate": "pnpm --filter @ai-guru/core migrate",
    "reset": "pnpm --filter @ai-guru/core reset",
    "list-chunks": "pnpm --filter @ai-guru/core list-chunks",
    "list-models": "pnpm --filter @ai-guru/core list-models",
    "backfill-videos": "pnpm --filter @ai-guru/core backfill-videos"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
