# === Gemini (required) ===
# Embedding + answer generation both use this key.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

GEMINI_BILLING_ENABLED=false
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_MAIN=gemini-3.6-flash
GEMINI_MODEL_STRONG=gemini-pro-latest
GEMINI_MODEL_EMBED=gemini-embedding-001
ENABLE_STRONG_ESCALATION=false

# === Database (required) — Postgres 16 with pgvector ===
# Reuse the LMS Postgres (enable `CREATE EXTENSION vector;` on that DB) or
# a separate Supabase instance. Migrations create their own tables so no
# clash with LMS tables.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# === Learner auth (STRONGLY RECOMMENDED for anything past local dev) ===
# HMAC secret shared with lms-service. LMS mints a JWT with claims
#   { sub: userId, tenant: <UUID>, courses: [<courseId>, ...], iat, exp }
# signed with this secret; the widget sends it as Authorization: Bearer.
# If UNSET, /ask runs unauthenticated and trusts client-supplied courseIds
# (POC-only convenience). MUST be set before exposing externally.
LMS_JWT_SECRET=
# Optional issuer/audience checks — if set, tokens with a different iss/aud
# are rejected.
# LMS_JWT_ISSUER=lms.templetraining.com
# LMS_JWT_AUDIENCE=lms-rag

# === Admin auth ===
# Gates /admin/* routes when set. lms-service should pass this as
# Authorization: Bearer <ADMIN_TOKEN> on ingest webhooks.
ADMIN_TOKEN=

# === Gumlet transcript API (optional) ===
# Enables PUT /admin/chapters/:chid/video-from-gumlet — the RAG fetches the
# VTT/SRT track from Gumlet and ingests it. Skip if lms-service uploads
# subtitles directly via PUT /admin/chapters/:chid/video.
GUMLET_API_KEY=
GUMLET_API_BASE=https://api.gumlet.com/v1

# === Ingest queue ===
# How often the background worker polls for new jobs (ms).
INGEST_POLL_MS=3000
# How many jobs one poll cycle processes.
INGEST_BATCH_SIZE=1
# Set to '1' to run this instance as API-only (no worker). Useful when you
# scale out — one dedicated worker instance + N stateless API instances.
INGEST_WORKER_DISABLED=

# === Retrieval tuning ===
# Post-RRF dedupe caps (spec: max 3 chunks/video, top 5 videos).
MAX_CUES_PER_VIDEO=3
MAX_VIDEOS=5

# Video recommendation gating — cues below this RRF score aren't fed to the LLM.
VIDEO_MIN_ABSOLUTE_SCORE=0.015
VIDEO_INCLUDE_MAX_CUES=1

# === Caches (on-disk, keyed by SHA-256 hash) ===
CACHE_DIR=.cache
EMBEDDING_CACHE_DIR=.cache/embeddings
EVAL_LLM_CACHE_DIR=.cache/eval

# === API ===
API_PORT=3000
API_HOST=127.0.0.1

# === Ingest ===
CHUNK_TARGET_TOKENS=425
CHUNK_MAX_TOKENS=1800

# Set to 'true' to run the Flash-Lite glossary correction pass over each
# video's raw VTT before embedding. Off by default (fixture VTTs are clean).
INGEST_CORRECT_VIDEOS=false

# === Fixtures ===
# Only needed for the sample-video ingest. Point at wherever you extract
# fixtures/ inside lms-rag/.
# GUMLET_FIXTURES_DIR=C:\path\to\lms-rag\fixtures\gumlet

# === Glossary ===
# Path to a JSON file the ingest worker loads on boot. If missing/unreadable,
# glossary correction is silently skipped.
# GLOSSARY_PATH=fixtures/glossary/glossary.example.json
